{
  "filters": {
    "and": [
      "file.ext == \"md\"",
      "council_tracker == true",
      "!file.inFolder(\"Templates\")"
    ]
  },
  "formulas": {
    "is_open": "stage != \"Passed\" && stage != \"Vetoed / Failed\" && stage != \"Withdrawn\" && stage != \"Closed\"",
    "current_period": "\"FY\" + (today().year + if(today().month >= 7, 1, 0)) + \" Q\" + (((today().month + 5) % 12 / 3).floor() + 1)",
    "planned_period": "if(target_period, target_period, if(target_date, \"FY\" + (date(target_date).year + if(date(target_date).month >= 7, 1, 0)) + \" Q\" + (((date(target_date).month + 5) % 12 / 3).floor() + 1), \"\"))",
    "priority_rank": "if(priority == \"High\", 1, if(priority == \"Low\", 3, 2))",
    "needs_attention": "migration_review == true || (review_on && date(review_on) <= today()) || (queue != \"Closed\" && blocker) || (queue == \"Active\" && next_action.isEmpty()) || queue == \"Unassigned\""
  },
  "properties": {
    "note.tracker_title": {
      "displayName": "Initiative"
    },
    "note.next_action": {
      "displayName": "Next action"
    },
    "note.review_on": {
      "displayName": "Review on"
    },
    "note.legal_review": {
      "displayName": "Legal review"
    },
    "formula.planned_period": {
      "displayName": "Target period"
    },
    "formula.priority_rank": {
      "displayName": "Priority order"
    },
    "note.migration_review": {
      "displayName": "Reconcile"
    }
  },
  "views": [
    {
      "type": "table",
      "name": "My next actions",
      "filters": {
        "and": [
          "lead == \"Díaz\"",
          "queue == \"Active\" || queue == \"Monitoring\""
        ]
      },
      "order": [
        "note.tracker_title",
        "note.stage",
        "note.lead",
        "note.next_action",
        "note.blocker",
        "note.review_on"
      ],
      "sort": [
        {
          "property": "formula.priority_rank",
          "direction": "ASC"
        },
        {
          "property": "note.review_on",
          "direction": "ASC"
        }
      ],
      "rowHeight": "extra",
      "columnSize": {
        "note.tracker_title": 320,
        "note.next_action": 440,
        "note.lead": 155
      }
    },
    {
      "type": "table",
      "name": "Legislative pipeline",
      "filters": {
        "and": [
          "track == \"Legislation\"",
          "formula.is_open == true",
          "queue == \"Active\""
        ]
      },
      "order": [
        "note.tracker_title",
        "note.next_action",
        "note.lead"
      ],
      "sort": [
        {
          "property": "formula.priority_rank",
          "direction": "ASC"
        },
        {
          "property": "note.review_on",
          "direction": "ASC"
        }
      ],
      "groupBy": {
        "property": "note.stage",
        "direction": "ASC"
      },
      "rowHeight": "extra",
      "columnSize": {
        "note.tracker_title": 320,
        "note.next_action": 440,
        "note.lead": 155
      }
    },
    {
      "type": "table",
      "name": "Needs attention",
      "filters": "formula.needs_attention == true",
      "order": [
        "note.tracker_title",
        "note.stage",
        "note.lead",
        "note.next_action",
        "note.blocker",
        "note.review_on",
        "note.migration_review",
        "note.stage_source_date"
      ],
      "sort": [
        {
          "property": "formula.priority_rank",
          "direction": "ASC"
        },
        {
          "property": "note.review_on",
          "direction": "ASC"
        }
      ],
      "rowHeight": "extra",
      "columnSize": {
        "note.tracker_title": 320,
        "note.next_action": 440,
        "note.lead": 155
      }
    },
    {
      "type": "table",
      "name": "This fiscal quarter",
      "filters": {
        "and": [
          "formula.planned_period == formula.current_period",
          "queue != \"Closed\""
        ]
      },
      "order": [
        "note.tracker_title",
        "note.stage",
        "note.lead",
        "note.next_action",
        "note.blocker",
        "note.review_on",
        "formula.planned_period",
        "note.target_date"
      ],
      "sort": [
        {
          "property": "formula.priority_rank",
          "direction": "ASC"
        },
        {
          "property": "note.review_on",
          "direction": "ASC"
        }
      ],
      "rowHeight": "extra",
      "columnSize": {
        "note.tracker_title": 320,
        "note.next_action": 440,
        "note.lead": 155
      }
    },
    {
      "type": "table",
      "name": "Queued and backlog",
      "filters": "queue == \"Queued\" || queue == \"Backlog\"",
      "order": [
        "note.tracker_title",
        "note.stage",
        "note.lead",
        "note.next_action",
        "note.blocker",
        "note.review_on",
        "formula.planned_period"
      ],
      "sort": [
        {
          "property": "formula.planned_period",
          "direction": "ASC"
        },
        {
          "property": "formula.priority_rank",
          "direction": "ASC"
        }
      ],
      "groupBy": {
        "property": "note.queue",
        "direction": "ASC"
      },
      "rowHeight": "extra",
      "columnSize": {
        "note.tracker_title": 320,
        "note.next_action": 440,
        "note.lead": 155
      }
    },
    {
      "type": "table",
      "name": "Implementation and monitoring",
      "filters": "queue == \"Monitoring\" || (stage == \"Passed\" && next_action)",
      "order": [
        "note.tracker_title",
        "note.stage",
        "note.lead",
        "note.next_action",
        "note.blocker",
        "note.review_on"
      ],
      "sort": [
        {
          "property": "formula.priority_rank",
          "direction": "ASC"
        },
        {
          "property": "note.review_on",
          "direction": "ASC"
        }
      ],
      "rowHeight": "extra",
      "columnSize": {
        "note.tracker_title": 320,
        "note.next_action": 440,
        "note.lead": 155
      }
    },
    {
      "type": "table",
      "name": "All initiatives",
      "order": [
        "note.tracker_title",
        "note.track",
        "note.queue",
        "note.stage",
        "note.lead",
        "formula.planned_period",
        "note.next_action",
        "note.legal_review"
      ],
      "sort": [
        {
          "property": "note.tracker_title",
          "direction": "ASC"
        }
      ],
      "rowHeight": "extra",
      "columnSize": {
        "note.tracker_title": 320,
        "note.next_action": 440,
        "note.lead": 155
      }
    }
  ]
}
